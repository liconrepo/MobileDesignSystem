<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Atoms and molecules composed into a distinct section of an interface. The card is the container they live in."
        android:textAppearance="@style/Mds.TextAppearance.Body" />

    <TextView
        style="@style/Sample.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mds_space_xl"
        android:text="Profile card" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mds_space_xs"
        android:layout_marginBottom="@dimen/mds_space_md"
        android:text="Card, avatar, text, badge and button. Skeletons hold its place while it loads."
        android:textAppearance="@style/Mds.TextAppearance.BodySmall" />

    <io.github.liconrepo.mds.functional.organisms.MdsCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:mdsCardVariant="elevated">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/skeletonGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <io.github.liconrepo.mds.functional.atoms.MdsSkeleton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:mdsSkeletonCircle="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mds_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <io.github.liconrepo.mds.functional.atoms.MdsSkeleton
                        android:layout_width="160dp"
                        android:layout_height="14dp" />

                    <io.github.liconrepo.mds.functional.atoms.MdsSkeleton
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="@dimen/mds_space_md" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/loadedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <io.github.liconrepo.mds.functional.atoms.MdsAvatar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:mdsAvatarName="Katherine Johnson"
                    app:mdsAvatarSize="large" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mds_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Katherine Johnson"
                        android:textAppearance="@style/Mds.TextAppearance.TitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Content has arrived."
                        android:textAppearance="@style/Mds.TextAppearance.BodySmall" />

                    <io.github.liconrepo.mds.functional.atoms.MdsBadge
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mds_space_md"
                        android:text="Verified"
                        app:mdsTone="success" />
                </LinearLayout>
            </LinearLayout>

            <io.github.liconrepo.mds.functional.atoms.MdsButton
                android:id="@+id/btnToggleSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mds_space_lg"
                android:text="Load content"
                app:mdsButtonVariant="outline" />
        </LinearLayout>
    </io.github.liconrepo.mds.functional.organisms.MdsCard>

    <TextView
        style="@style/Sample.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mds_space_xl"
        android:text="Account summary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mds_space_xs"
        android:layout_marginBottom="@dimen/mds_space_md"
        android:text="A header row, list items and an action in one card. Every part is a component from the layers above."
        android:textAppearance="@style/Mds.TextAppearance.BodySmall" />

    <io.github.liconrepo.mds.functional.organisms.MdsCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/mds_space_lg">

                <io.github.liconrepo.mds.functional.atoms.MdsAvatar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:mdsAvatarName="Dorothy Vaughan"
                    app:mdsAvatarSize="large" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mds_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dorothy Vaughan"
                        android:textAppearance="@style/Mds.TextAppearance.TitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pro plan"
                        android:textAppearance="@style/Mds.TextAppearance.BodySmall" />
                </LinearLayout>

                <io.github.liconrepo.mds.functional.atoms.MdsBadge
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid"
                    app:mdsTone="success" />
            </LinearLayout>

            <io.github.liconrepo.mds.functional.molecules.MdsListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:mdsListItemIcon="@drawable/mds_ic_info"
                    app:mdsListItemShowChevron="true"
                app:mdsListItemSubtitle="Next invoice on the 1st"
                app:mdsListItemTitle="Billing" />

            <io.github.liconrepo.mds.functional.molecules.MdsListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:mdsListItemIcon="@drawable/mds_ic_check"
                    app:mdsListItemShowChevron="true"
                app:mdsListItemSubtitle="Two-step sign-in is on"
                app:mdsListItemTitle="Security" />

            <io.github.liconrepo.mds.functional.atoms.MdsButton
                style="@style/Mds.Widget.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/mds_space_lg"
                android:text="Manage account" />
        </LinearLayout>
    </io.github.liconrepo.mds.functional.organisms.MdsCard>
</LinearLayout>
