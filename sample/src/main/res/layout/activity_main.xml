<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Hero -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/mds_space_xl"
        android:paddingTop="@dimen/mds_space_lg"
        android:paddingBottom="@dimen/mds_space_lg">

        <io.github.liconrepo.mds.functional.atoms.MdsBadge
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.1.0  ·  Views + Kotlin"
            app:mdsTone="neutral"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mds_space_sm"
            android:text="Mobile Design System"
            android:textAppearance="@style/Mds.TextAppearance.Headline"
            android:textColor="?attr/mdsColorOnPrimary"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mds_space_xs"
            android:text="Pick a layer to see its parts."
            android:textAppearance="@style/Mds.TextAppearance.BodySmall"
            android:textColor="?attr/mdsColorOnPrimary"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Tabs: one per layer. Built from MdsChip in code. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mdsColorSurface"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/mds_space_lg"
            android:paddingVertical="@dimen/mds_space_xs" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/mds_stroke_thin"
        android:background="?attr/mdsColorOutline" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/mds_space_lg">

            <FrameLayout
                android:id="@+id/tabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mds_space_xl"
                android:gravity="center"
                android:text="MIT licensed. Contributions welcome."
                android:textAppearance="@style/Mds.TextAppearance.Caption"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
